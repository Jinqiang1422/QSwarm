{
  "name": "区域搜索后返航",
  "description": "三阶段：全体起飞→矩形区域条带覆盖搜索→完成后自动返航降落",
  "version": 1,
  "parameters": [
    {
      "key": "altitude",
      "label": "作业高度(米)",
      "type": "number",
      "default": 30,
      "min": 10,
      "max": 120
    },
    {
      "key": "length",
      "label": "区域长度(米)",
      "type": "number",
      "default": 200,
      "min": 20,
      "max": 100000
    },
    {
      "key": "width",
      "label": "区域宽度(米)",
      "type": "number",
      "default": 150,
      "min": 20,
      "max": 100000
    },
    {
      "key": "angle",
      "label": "航线角度(度)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 359
    },
    {
      "key": "spacing",
      "label": "行距(米)",
      "type": "number",
      "default": 20,
      "min": 5,
      "max": 200
    },
    {
      "key": "climb_gate",
      "label": "升空判定高度(米)",
      "type": "number",
      "default": 25,
      "min": 5,
      "max": 115
    }
  ],
  "stages": [
    {
      "name": "起飞",
      "actions": [
        {
          "type": "takeoff",
          "altitude": "${altitude}"
        }
      ],
      "complete_when": {
        "kind": "all_airborne",
        "min_altitude": "${climb_gate}"
      }
    },
    {
      "name": "区域搜索",
      "actions": [
        {
          "type": "plan_coverage",
          "center": "map_center",
          "length": "${length}",
          "width": "${width}",
          "angle": "${angle}",
          "spacing": "${spacing}",
          "altitude": "${altitude}"
        },
        {
          "type": "start_mission"
        }
      ],
      "complete_when": {
        "kind": "all_mission_finished"
      }
    },
    {
      "name": "返航",
      "actions": [
        {
          "type": "rtl"
        }
      ],
      "complete_when": {
        "kind": "all_disarmed"
      }
    }
  ]
}