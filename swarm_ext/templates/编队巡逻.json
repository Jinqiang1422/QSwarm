{
  "name": "编队巡逻",
  "description": "起飞后以主队形巡逻一段时间，变换队形继续巡逻，结束后停止编队返航",
  "version": 1,
  "schema_version": 2,
  "tags": [
    "巡逻",
    "编队"
  ],
  "min_fleet": 3,
  "parameters": [
    {
      "key": "altitude",
      "label": "作业高度（米）",
      "type": "number",
      "default": 40,
      "min": 10,
      "max": 120
    },
    {
      "key": "climb_gate",
      "label": "升空判定高度（米）",
      "type": "number",
      "default": 35,
      "min": 5,
      "max": 115
    },
    {
      "key": "leader_id",
      "label": "长机编号",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 250
    },
    {
      "key": "formation",
      "label": "主队形（wedge/column/line/circle）",
      "type": "string",
      "default": "wedge"
    },
    {
      "key": "spacing",
      "label": "编队间距（米）",
      "type": "number",
      "default": 15,
      "min": 2,
      "max": 500
    },
    {
      "key": "patrol_seconds",
      "label": "第一程巡逻时长（秒）",
      "type": "integer",
      "default": 180,
      "min": 10,
      "max": 7200
    },
    {
      "key": "second_formation",
      "label": "第二队形（wedge/column/line/circle）",
      "type": "string",
      "default": "column"
    },
    {
      "key": "patrol_seconds_2",
      "label": "第二程巡逻时长（秒）",
      "type": "integer",
      "default": 180,
      "min": 10,
      "max": 7200
    }
  ],
  "stages": [
    {
      "name": "起飞",
      "actions": [
        {
          "type": "takeoff",
          "altitude": "${altitude}"
        }
      ],
      "complete_when": {
        "kind": "all_airborne",
        "min_altitude": "${climb_gate}",
        "timeout_sec": 180
      }
    },
    {
      "name": "主队形就位",
      "actions": [
        {
          "type": "start_formation",
          "leader_id": "${leader_id}",
          "formation": "${formation}",
          "spacing": "${spacing}"
        }
      ],
      "complete_when": {
        "kind": "formation_running"
      }
    },
    {
      "name": "第一程巡逻",
      "actions": [],
      "complete_when": {
        "kind": "duration",
        "seconds": "${patrol_seconds}"
      }
    },
    {
      "name": "变换队形",
      "actions": [
        {
          "type": "start_formation",
          "leader_id": "${leader_id}",
          "formation": "${second_formation}",
          "spacing": "${spacing}"
        }
      ],
      "complete_when": {
        "kind": "formation_running"
      }
    },
    {
      "name": "第二程巡逻",
      "actions": [],
      "complete_when": {
        "kind": "duration",
        "seconds": "${patrol_seconds_2}"
      }
    },
    {
      "name": "返航",
      "actions": [
        {
          "type": "stop_formation"
        },
        {
          "type": "rtl"
        }
      ],
      "complete_when": {
        "kind": "all_disarmed",
        "timeout_sec": 600
      }
    }
  ]
}