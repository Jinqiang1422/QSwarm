{
  "name": "扇形扫掠搜索",
  "description": "三扇区依次扫掠：全体起飞后按设定角度对三个扇区依次覆盖搜索，完成后返航",
  "version": 1,
  "builtin_revision": 2,
  "schema_version": 2,
  "tags": [
    "搜索",
    "扫掠",
    "覆盖"
  ],
  "min_fleet": 3,
  "required_payload": "camera",
  "parameters": [
    {
      "key": "altitude",
      "label": "作业高度（米）",
      "type": "number",
      "default": 30,
      "min": 10,
      "max": 120
    },
    {
      "key": "climb_gate",
      "label": "升空判定高度（米）",
      "type": "number",
      "default": 25,
      "min": 5,
      "max": 115
    },
    {
      "key": "length",
      "label": "扇区长度（米）",
      "type": "number",
      "default": 300,
      "min": 20,
      "max": 100000
    },
    {
      "key": "width",
      "label": "扇区宽度（米）",
      "type": "number",
      "default": 150,
      "min": 20,
      "max": 100000
    },
    {
      "key": "spacing",
      "label": "行距（米）",
      "type": "number",
      "default": 20,
      "min": 5,
      "max": 200
    },
    {
      "key": "angle1",
      "label": "扇区1角度（度）",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 359
    },
    {
      "key": "angle2",
      "label": "扇区2角度（度）",
      "type": "number",
      "default": 60,
      "min": 0,
      "max": 359
    },
    {
      "key": "angle3",
      "label": "扇区3角度（度）",
      "type": "number",
      "default": 120,
      "min": 0,
      "max": 359
    }
  ],
  "stages": [
    {
      "name": "起飞",
      "actions": [
        {
          "type": "takeoff",
          "altitude": "${altitude}"
        }
      ],
      "complete_when": {
        "kind": "all_airborne",
        "min_altitude": "${climb_gate}",
        "timeout_sec": 180
      }
    },
    {
      "name": "扇区1扫掠",
      "actions": [
        {
          "type": "plan_coverage",
          "center": "map_center",
          "length": "${length}",
          "width": "${width}",
          "angle": "${angle1}",
          "spacing": "${spacing}",
          "altitude": "${altitude}"
        },
        {
          "type": "start_mission"
        }
      ],
      "complete_when": {
        "kind": "all_mission_finished"
      }
    },
    {
      "name": "扇区2扫掠",
      "actions": [
        {
          "type": "plan_coverage",
          "center": "map_center",
          "length": "${length}",
          "width": "${width}",
          "angle": "${angle2}",
          "spacing": "${spacing}",
          "altitude": "${altitude}"
        },
        {
          "type": "start_mission"
        }
      ],
      "complete_when": {
        "kind": "all_mission_finished"
      }
    },
    {
      "name": "扇区3扫掠",
      "actions": [
        {
          "type": "plan_coverage",
          "center": "map_center",
          "length": "${length}",
          "width": "${width}",
          "angle": "${angle3}",
          "spacing": "${spacing}",
          "altitude": "${altitude}"
        },
        {
          "type": "start_mission"
        }
      ],
      "complete_when": {
        "kind": "all_mission_finished"
      }
    },
    {
      "name": "返航",
      "actions": [
        {
          "type": "rtl"
        }
      ],
      "complete_when": {
        "kind": "all_disarmed",
        "timeout_sec": 600
      }
    }
  ]
}
