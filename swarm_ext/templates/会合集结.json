{
  "name": "会合集结",
  "description": "起飞后以长机为集结点组成环形编队收拢，保持后全体返航",
  "version": 1,
  "builtin_revision": 2,
  "schema_version": 2,
  "tags": [
    "集结",
    "编队"
  ],
  "min_fleet": 3,
  "parameters": [
    {
      "key": "altitude",
      "label": "集结高度（米）",
      "type": "number",
      "default": 30,
      "min": 10,
      "max": 120
    },
    {
      "key": "climb_gate",
      "label": "升空判定高度（米）",
      "type": "number",
      "default": 25,
      "min": 5,
      "max": 115
    },
    {
      "key": "leader_id",
      "label": "集结长机编号",
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 250
    },
    {
      "key": "gather_radius",
      "label": "集结半径（米）",
      "type": "number",
      "default": 20,
      "min": 5,
      "max": 200
    },
    {
      "key": "hold_seconds",
      "label": "集结保持时长（秒）",
      "type": "integer",
      "default": 60,
      "min": 10,
      "max": 3600
    }
  ],
  "stages": [
    {
      "name": "起飞",
      "actions": [
        {
          "type": "takeoff",
          "altitude": "${altitude}"
        }
      ],
      "complete_when": {
        "kind": "all_airborne",
        "min_altitude": "${climb_gate}",
        "timeout_sec": 180
      }
    },
    {
      "name": "集结",
      "actions": [
        {
          "type": "start_formation",
          "leader_id": "${leader_id}",
          "formation": "circle",
          "spacing": "${gather_radius}"
        }
      ],
      "complete_when": {
        "kind": "formation_running"
      }
    },
    {
      "name": "集结保持",
      "actions": [],
      "complete_when": {
        "kind": "duration",
        "seconds": "${hold_seconds}"
      }
    },
    {
      "name": "返航",
      "actions": [
        {
          "type": "stop_formation"
        },
        {
          "type": "rtl"
        }
      ],
      "complete_when": {
        "kind": "all_disarmed",
        "timeout_sec": 600
      }
    }
  ]
}
