{
  "name": "11 航线上传后收紧限高",
  "fleet": 2,
  "requires_qgc": true,
  "steps": [
    {"action": "wait_all_online", "timeout_sec": 120},
    {"action": "qgc_start_task", "name": "限高变化验收", "stages": [
      {"name": "规划待确认", "actions": [{"type": "plan_coverage", "length": 30, "width": 30, "altitude": 20}], "complete_when": {"kind": "manual"}},
      {"name": "启动机载任务", "actions": [{"type": "start_mission"}], "complete_when": {"kind": "all_mission_finished"}}
    ]},
    {"action": "qgc_expect_task", "running": true, "stage_index": 0, "waiting_for_proceed": true, "timeout_sec": 120},
    {"action": "qgc_configure_execution", "settings": {"constraints": {"max_altitude_m": 3}}},
    {"action": "qgc_proceed_task"},
    {"action": "qgc_expect_task", "running": true, "blocked": true, "stage_index": 1, "outcome": "None", "timeout_sec": 120},
    {"action": "qgc_expect_dispatch_counts", "counts": {"1": {"arm": 0, "start_mission": 0}, "2": {"arm": 0, "start_mission": 0}}},
    {"action": "qgc_abort_task"},
    {"action": "qgc_expect_task", "running": false, "outcome": "Aborted", "disarmed_ids": [1, 2]}
  ],
  "pass_criteria": {"all_steps_completed": true, "max_total_sec": 300}
}
