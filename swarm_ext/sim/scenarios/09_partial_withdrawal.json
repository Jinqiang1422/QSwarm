{
  "name": "09 两机任务局部退出与后续阶段",
  "fleet": 2,
  "requires_qgc": true,
  "description": "两机升空后通过确认动作让 1 号机暂停退出；2 号机继续后续返航阶段并完成任务，最后回收 1 号机。",
  "steps": [
    {"t": 0, "action": "wait_all_online", "timeout_sec": 120},
    {
      "t": 0,
      "action": "qgc_start_task",
      "name": "局部退出飞行验收",
      "stages": [
        {
          "name": "两机升空待命",
          "actions": [{"type": "arm", "arm": true}, {"type": "takeoff", "altitude": 20}],
          "complete_when": {"kind": "manual", "timeout_sec": 240}
        },
        {
          "name": "剩余成员返航",
          "actions": [{"type": "rtl"}],
          "complete_when": {"kind": "all_disarmed", "timeout_sec": 180, "grace_sec": 1}
        }
      ]
    },
    {"t": 0, "action": "wait_all_airborne", "min_altitude": 15, "timeout_sec": 180},
    {"t": 0, "action": "qgc_expect_task", "running": true, "stage_index": 0, "waiting_for_proceed": true},
    {
      "t": 0,
      "action": "qgc_execute_actions",
      "origin": "operator",
      "actions": [{"type": "set_selection", "vehicle_ids": [1]}, {"type": "pause"}]
    },
    {"t": 0, "action": "wait_seconds", "seconds": 1},
    {"t": 0, "action": "qgc_proceed_task"},
    {"t": 0, "action": "qgc_expect_task", "running": false, "timeout_sec": 180},
    {"t": 0, "action": "rtl_all"},
    {"t": 0, "action": "wait_all_disarmed_or_low", "max_altitude": 2, "timeout_sec": 120}
  ],
  "pass_criteria": {"all_steps_completed": true, "max_total_sec": 420}
}
